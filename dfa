START (accept) <-- the start state
   /: MAYBECOMMENT
   ': SINGLEQUOTE
   ": DOUBLEQUOTE
   other:  START

DOUBLEQUOTE (accept)
    \: DOUBLEESCAPE
    ": START
    other: DOUBLEQUOTE

DOUBLEESCAPE (accept)
    any: DOUBLEQUOTE

SINGLEQUOTE (accept)
    \: SINGLEESCAPE
    ': START
    other: SINGLEQUOTE

SINGLEESCAPE (accept)
    any: SINGLEQUOTE

MAYBECOMMENT (accept)
   *: COMMENT
   ': SINGLEQUOTE
   ": DOUBLEQUOTE
   /: MAYBECOMMENT
   other:  START
   
COMMENT (reject)
   *:  MAYBEEND
   other:  COMMENT
   (\n: COMMENT but print \n)
   
MAYBEEND (reject)
   /: START
   *: MAYBEEND
   other: COMMENT
   (\n: COMMENT but print \n)